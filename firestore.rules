rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isParent() {
      return userExists() && currentUser().role == 'parent';
    }

    function isChild() {
      return userExists() && currentUser().role == 'child';
    }

    function belongsToFamily(familyId) {
      return userExists() && currentUser().familyId == familyId;
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    function familyUnchanged() {
      return request.resource.data.familyId == resource.data.familyId;
    }

    function claimingOwnFamily() {
      return resource.data.role == 'parent'
        && request.resource.data.familyId is string
        && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.parentId
            == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || (userExists() && resource.data.familyId == currentUser().familyId);

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['parent', 'child']
        || (isParent()
            && request.resource.data.role == 'child'
            && request.resource.data.familyId == currentUser().familyId
            && request.resource.data.uid == uid);

      allow update: if (isSelf(uid)
            && roleUnchanged()
            && (familyUnchanged() || claimingOwnFamily())
            && (isParent()
                || request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['lastActiveAt', 'locationSharingEnabled'])))
        || (isParent()
            && resource.data.familyId == currentUser().familyId
            && roleUnchanged()
            && familyUnchanged()
            && request.resource.data.uid == resource.data.uid);
    }

    match /families/{familyId} {
      allow read: if belongsToFamily(familyId)
        || (signedIn() && resource.data.parentId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.familyId == familyId;

      allow update: if isParent() && belongsToFamily(familyId)
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.familyId == resource.data.familyId;

      match /children/{childId} {
        allow read: if belongsToFamily(familyId)
          || (signedIn()
              && get(/databases/$(database)/documents/families/$(familyId)).data.parentId
                  == request.auth.uid);

        allow create, update: if isParent()
          && belongsToFamily(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.role == 'child'
          && request.resource.data.uid == childId;
      }

      match /activities/{activityId} {
        allow read: if belongsToFamily(familyId);

        allow create: if isParent()
          && belongsToFamily(familyId)
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if (isParent() && belongsToFamily(familyId))
          || (isChild()
              && resource.data.childId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['completed', 'completedAt', 'pointsAwarded']));
      }

      match /locations/{locationId} {
        allow read: if belongsToFamily(familyId);

        allow create, update: if isChild()
          && belongsToFamily(familyId)
          && locationId == request.auth.uid
          && request.resource.data.childId == request.auth.uid;

        allow delete: if isChild()
          && belongsToFamily(familyId)
          && resource.data.childId == request.auth.uid;
      }

      match /screenTime/{childId} {
        allow read: if belongsToFamily(familyId);

        allow create, update: if isChild()
          && belongsToFamily(familyId)
          && childId == request.auth.uid
          && request.resource.data.childId == request.auth.uid
          && request.resource.data.source == 'device';

        allow update: if isParent()
          && belongsToFamily(familyId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['dailyLimitMinutes']);
      }

      match /gameProgress/{progressId} {
        allow read: if belongsToFamily(familyId);

        allow create, update: if isChild()
          && belongsToFamily(familyId)
          && request.resource.data.childId == request.auth.uid;
      }

      match /points/{childId} {
        allow read: if belongsToFamily(familyId);

        allow create, update: if isChild()
          && belongsToFamily(familyId)
          && request.auth.uid == childId
          && request.resource.data.childId == request.auth.uid;
      }

      match /wallets/{childId} {
        allow read: if belongsToFamily(familyId)
          && (isParent() || request.auth.uid == childId);

        allow create, update: if isParent()
          && belongsToFamily(familyId)
          && request.resource.data.childId == childId;

        match /transactions/{transactionId} {
          allow read: if belongsToFamily(familyId)
            && (isParent() || request.auth.uid == childId);

          allow create: if isParent()
            && belongsToFamily(familyId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.type in ['pocket_money', 'allowance', 'payment', 'adjustment']
            && request.resource.data.amount is number;

          allow update, delete: if false;
        }
      }

      match /messages/{messageId} {
        allow read: if belongsToFamily(familyId);

        allow create: if belongsToFamily(familyId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.familyId
              == familyId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update: if belongsToFamily(familyId)
          && request.auth.uid == resource.data.receiverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if belongsToFamily(familyId)
          && (isParent() || resource.data.childId == request.auth.uid);

        allow create: if isParent()
          && belongsToFamily(familyId)
          && request.resource.data.createdBy == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.resource.data.childId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.childId)).data.familyId
              == familyId;

        allow update: if (isParent() && belongsToFamily(familyId))
          || (isChild()
              && resource.data.childId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['completed']));

        allow delete: if isParent() && belongsToFamily(familyId);
      }
    }
  }
}
